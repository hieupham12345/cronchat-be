# Copy to deploy/.env.prod on the EC2 host and fill in real values.
# NEVER commit the real .env.prod (it is git-ignored).

# JWT signing secret — generate a strong random value, e.g.:
#   openssl rand -hex 32
GO_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# Listen address inside the container (keep :5555 to match the compose/Dockerfile)
BASE_URL=:5555

# ----- RDS MySQL connection (from provision.sh output) -----
MYSQL_HOST=REPLACE_WITH_RDS_ENDPOINT.ap-southeast-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=cronchat
MYSQL_USER=cronchat_admin
MYSQL_PASSWORD=CHANGE_ME_strong_db_password

# Upload dirs inside the container (mapped to host EBS volume by compose)
AVATAR_DIR=/app/data/user_avatars
CHAT_UPLOAD_DIR=/app/data/chat_uploads
